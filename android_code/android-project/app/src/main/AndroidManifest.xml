<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Overlay (floating bubble drawn over all apps) ────────────────────── -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ── Foreground service (base) ────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ── Media Projection — required for screen capture on all API levels ─── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- ── Notifications (required on Android 13+ / API 33+) ───────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Internet (ML Kit model download on first run) ────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── Wake lock — keeps OCR capture alive while game is running ─────────── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WalkersTranslate"
        android:localeConfig="@xml/locales_config">

        <!-- ── Splash Screen — entry point of the app ──────────────────────── -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.WalkersTranslate.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Main Activity — launched by SplashActivity ──────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WalkersTranslate" />

        <!-- ── Floating Overlay Foreground Service ──────────────────────────
             foregroundServiceType="mediaProjection" is mandatory on Android 14+
             (API 34+). Without it the system throws a SecurityException when
             MediaProjection is used inside a foreground service.
             ──────────────────────────────────────────────────────────────── -->
        <service
            android:name=".service.FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
