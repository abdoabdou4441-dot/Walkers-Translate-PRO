<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Main app theme — dark, no action bar.
        Compose Material 3 handles all colour tokens at runtime;
        this XML layer only governs system-UI chrome (status bar,
        nav bar, window background).
    -->
    <style name="Theme.WalkersTranslate" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
        Splash screen theme — full-screen, no status / nav bar chrome,
        pure black background so the animated content fades in cleanly.
    -->
    <style name="Theme.WalkersTranslate.Splash" parent="Theme.WalkersTranslate">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
